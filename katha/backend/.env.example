PORT=8080
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# Leave MONGO_URI blank to run against the built-in in-memory repository
# (handy for local dev / grading without an Atlas cluster). Set it to
# switch every repository over to MongoDB with zero controller changes -
# that swap is the whole point of the repository abstraction below.
MONGO_URI=

# Leave these blank to use the mocked AI/TTS adapters. Swap in real keys
# and flip USE_MOCK_AI=false once you plug in a real OpenAIAdapter/TTSAdapter.
USE_MOCK_AI=true
LLM_API_KEY=
TTS_API_KEY=
